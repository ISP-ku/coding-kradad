# Copy this file to .env and fill in real values, then run:
#     source .venv/bin/activate && python source/app.py
# .env is in .gitignore already - never commit the real one.

FLASK_SECRET_KEY=change-me-to-a-random-string

# --- Discord: https://discord.com/developers/applications ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a Redirect URI registered under OAuth2 -> General
DISCORD_REDIRECT_URI=http://localhost:5000/callback/discord

# --- Google: https://console.cloud.google.com/ (enable "Google Classroom API") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/callback/google

# --- LINE Login: https://developers.line.biz/console/ ---
# Create a "LINE Login" channel (NOT a Messaging API channel).
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_REDIRECT_URI=http://localhost:5000/callback/line

# Optional: override where app.py binds. If you change these, update every
# *_REDIRECT_URI above (and in each provider's console) to match.
# HOST=127.0.0.1
# PORT=5000

# Copy to .env. Never commit real credentials.
# Generate SESSION_SECRET: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/callback/google
FRONTEND_URL=http://localhost:3000
HOST=127.0.0.1
PORT=8000
# Use 1 only with HTTPS. Keep 0 for local HTTP development.
COOKIE_SECURE=0

# Local backend testing only. Disabled by default.
APP_ENV=development
LOCAL_TEST_LOGIN=1

# Who can sign in (SRS-23). Only members of at least one course can sign in.
# Lecturers manage courses, members and roles on the Access page (/access).
# LECTURER_EMAILS (comma-separated) are always lecturers, always allowed in,
# and cannot be removed or demoted on the Access page: put at least one real
# lecturer here so someone can open the Access page on a fresh install.
# TA_EMAILS only sets the starting role when an email is added without one.
# See source/users.py.
LECTURER_EMAILS=
TA_EMAILS=
# Courses and members loaded on first start only (when no course exists yet).
# COURSE_ROSTER_FILE=data/course_roster.json
# Set to 0 to turn the course-membership check off (not for production).
# REQUIRE_COURSE_MEMBERSHIP=1

# Optional. Defaults to a SQLite file, dashboard.db, in the repo root.
# DATABASE_URL=sqlite:///dashboard.db

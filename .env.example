# Copy to .env. Never commit real credentials.
# Generate SESSION_SECRET: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/callback/google
FRONTEND_URL=http://localhost:3000
HOST=127.0.0.1
PORT=8000
# Use 1 only with HTTPS. Keep 0 for local HTTP development.
COOKIE_SECURE=0

# Local backend testing only. Disabled by default.
APP_ENV=development
LOCAL_TEST_LOGIN=1

# Roles for real KU Google accounts (comma-separated emails). Anyone not
# listed signs in as a student. Re-checked on every login. See source/users.py.
LECTURER_EMAILS=
TA_EMAILS=

# Optional. Defaults to a SQLite file, dashboard.db, in the repo root.
# DATABASE_URL=sqlite:///dashboard.db
